<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MusicPlayer.App"
             xmlns:local="using:MusicPlayer"
             RequestedThemeVariant="Dark">
             <!-- Theme locked to "Dark" to prevent OS theme from affecting app appearance -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <!-- Palette: neon-noir, matches the pink-on-black app icon -->
            <Color x:Key="Bg0Color">#0B0B10</Color>       <!-- window -->
            <Color x:Key="Bg1Color">#121219</Color>       <!-- sidebar / player bar -->
            <Color x:Key="Bg2Color">#1A1A24</Color>       <!-- cards, inputs -->
            <Color x:Key="Bg3Color">#242431</Color>       <!-- hover -->
            <Color x:Key="Bg4Color">#2E2E3D</Color>       <!-- pressed -->
            <Color x:Key="LineColor">#23232F</Color>
            <Color x:Key="TextColor">#F3F3F8</Color>
            <Color x:Key="TextSecondaryColor">#9B9BB0</Color>
            <Color x:Key="TextMutedColor">#5E5E74</Color>
            <Color x:Key="AccentColor">#FF3D8E</Color>
            <Color x:Key="AccentHoverColor">#FF64A7</Color>
            <Color x:Key="AccentPressedColor">#D82B76</Color>
            <Color x:Key="AccentSoftColor">#26FF3D8E</Color>
            <Color x:Key="AccentGlowColor">#66FF3D8E</Color>

            <SolidColorBrush x:Key="Bg0Brush" Color="{StaticResource Bg0Color}"/>
            <SolidColorBrush x:Key="Bg1Brush" Color="{StaticResource Bg1Color}"/>
            <SolidColorBrush x:Key="Bg2Brush" Color="{StaticResource Bg2Color}"/>
            <SolidColorBrush x:Key="Bg3Brush" Color="{StaticResource Bg3Color}"/>
            <SolidColorBrush x:Key="Bg4Brush" Color="{StaticResource Bg4Color}"/>
            <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/>
            <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
            <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
            <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>
            <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>

            <!-- Re-tint the Fluent controls we don't restyle by hand (check boxes, sliders, list selection...) -->
            <Color x:Key="SystemAccentColor">#FF3D8E</Color>
            <Color x:Key="SystemAccentColorDark1">#E03380</Color>
            <Color x:Key="SystemAccentColorDark2">#C02A6E</Color>
            <Color x:Key="SystemAccentColorDark3">#A0225C</Color>
            <Color x:Key="SystemAccentColorLight1">#FF5C9F</Color>
            <Color x:Key="SystemAccentColorLight2">#FF7AB1</Color>
            <Color x:Key="SystemAccentColorLight3">#FF99C3</Color>

            <SolidColorBrush x:Key="SliderTrackFill" Color="#33FFFFFF"/>
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#44FFFFFF"/>
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#44FFFFFF"/>
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="{StaticResource AccentColor}"/>
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{StaticResource AccentHoverColor}"/>
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{StaticResource AccentHoverColor}"/>
            <SolidColorBrush x:Key="SliderThumbBackground" Color="{StaticResource TextColor}"/>
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="White"/>
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{StaticResource AccentHoverColor}"/>
            <x:Double x:Key="SliderHorizontalThumbWidth">14</x:Double>
            <x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>
            <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>

            <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#3AFFFFFF"/>
            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#55FFFFFF"/>
            <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#77FFFFFF"/>

            <!-- Icons (Material Design, 24x24 view box) -->
            <StreamGeometry x:Key="IconPlay">M8,5.14V19.14L19,12.14L8,5.14Z</StreamGeometry>
            <StreamGeometry x:Key="IconPause">M14,19H18V5H14M6,19H10V5H6V19Z</StreamGeometry>
            <StreamGeometry x:Key="IconNext">M16,18H18V6H16M6,18L14.5,12L6,6V18Z</StreamGeometry>
            <StreamGeometry x:Key="IconPrevious">M6,18V6H8V18H6M9.5,12L18,6V18L9.5,12Z</StreamGeometry>
            <StreamGeometry x:Key="IconForward">M13,6V18L21.5,12M4,18L12.5,12L4,6V18Z</StreamGeometry>
            <StreamGeometry x:Key="IconRewind">M11.5,12L20,18V6M11,18V6L2.5,12L11,18Z</StreamGeometry>
            <StreamGeometry x:Key="IconShuffle">M17,3L22.25,7.5L17,12L22.25,16.5L17,21V18H14.26L11.44,15.18L13.56,13.06L15.5,15H17V12L17,9H15.5L6.5,18H2V15H5.26L14.26,6H17V3M2,6H6.5L9.32,8.82L7.2,10.94L5.26,9H2V6Z</StreamGeometry>
            <StreamGeometry x:Key="IconRepeat">M17,17H7V14L3,18L7,22V19H19V13H17M7,7H17V10L21,6L17,2V5H5V11H7V7Z</StreamGeometry>
            <StreamGeometry x:Key="IconRepeatOne">M13,15V9H12L10,10V11H11.5V15M17,17H7V14L3,18L7,22V19H19V13H17M7,7H17V10L21,6L17,2V5H5V11H7V7Z</StreamGeometry>
            <StreamGeometry x:Key="IconVolume">M14,3.23V5.29C16.89,6.15 19,8.83 19,12C19,15.17 16.89,17.84 14,18.7V20.77C18,19.86 21,16.28 21,12C21,7.72 18,4.14 14,3.23M16.5,12C16.5,10.23 15.5,8.71 14,7.97V16C15.5,15.29 16.5,13.76 16.5,12M3,9V15H7L12,20V4L7,9H3Z</StreamGeometry>
            <StreamGeometry x:Key="IconSearch">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</StreamGeometry>
            <StreamGeometry x:Key="IconFolder">M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z</StreamGeometry>
            <StreamGeometry x:Key="IconPlaylist">M15,6H3V8H15V6M15,10H3V12H15V10M3,16H11V14H3V16M17,6V14.18C16.69,14.07 16.35,14 16,14A3,3 0 0,0 13,17A3,3 0 0,0 16,20A3,3 0 0,0 19,17V8H22V6H17Z</StreamGeometry>
            <StreamGeometry x:Key="IconPlaylistPlus">M3,16H10V14H3M18,14V10H16V14H12V16H16V20H18V16H22V14M14,6H3V8H14M14,10H3V12H14V10Z</StreamGeometry>
            <StreamGeometry x:Key="IconMusic">M21,3V15.5A3.5,3.5 0 0,1 17.5,19A3.5,3.5 0 0,1 14,15.5A3.5,3.5 0 0,1 17.5,12C18.04,12 18.55,12.12 19,12.34V6.47L9,8.6V17.5A3.5,3.5 0 0,1 5.5,21A3.5,3.5 0 0,1 2,17.5A3.5,3.5 0 0,1 5.5,14C6.04,14 6.55,14.12 7,14.34V6L21,3Z</StreamGeometry>
            <StreamGeometry x:Key="IconLibrary">M4,6H2V20A2,2 0 0,0 4,22H18V20H4M20,2H8A2,2 0 0,0 6,4V16A2,2 0 0,0 8,18H20A2,2 0 0,0 22,16V4A2,2 0 0,0 20,2M18,7H15V12.5A2.5,2.5 0 0,1 12.5,15A2.5,2.5 0 0,1 10,12.5A2.5,2.5 0 0,1 12.5,10C13.07,10 13.58,10.19 14,10.5V5H18V7Z</StreamGeometry>
            <StreamGeometry x:Key="IconDownload">M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z</StreamGeometry>
            <StreamGeometry x:Key="IconRefresh">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</StreamGeometry>
            <StreamGeometry x:Key="IconPlus">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</StreamGeometry>
            <StreamGeometry x:Key="IconMinus">M19,13H5V11H19V13Z</StreamGeometry>
            <StreamGeometry x:Key="IconClose">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</StreamGeometry>
            <StreamGeometry x:Key="IconEqualizer">M10,20H14V4H10V20M4,20H8V12H4V20M16,9V20H20V9H16Z</StreamGeometry>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Global defaults -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource Bg0Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        </Style>
        <Style Selector="TextBlock.section-label">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="1.2"/>
        </Style>
        <Style Selector="PathIcon">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="{StaticResource Bg3Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Buttons -->
        <!-- Base: every button gets a cursor, a radius and smooth background transitions -->
        <Style Selector="Button, ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter, ToggleButton /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <!-- Primary (accent) -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentPressedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Secondary (neutral surface) -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Bg3Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style Selector="Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Bg4Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style Selector="Button.secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style Selector="Button.secondary PathIcon">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
        </Style>

        <!-- Icon-only (transparent) -->
        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="18"/>
        </Style>
        <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Bg3Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Bg4Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.icon PathIcon">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
        </Style>
        <Style Selector="Button.icon.small">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>
        <Style Selector="Button.icon.small PathIcon">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
        </Style>

        <!-- Big round play button with a soft glow -->
        <Style Selector="Button.play">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="CornerRadius" Value="26"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.play:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.play:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentPressedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.play PathIcon">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
        </Style>

        <!-- Shuffle / repeat toggles -->
        <Style Selector="ToggleButton.mode">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="18"/>
        </Style>
        <Style Selector="ToggleButton.mode PathIcon">
            <Setter Property="Width" Value="17"/>
            <Setter Property="Height" Value="17"/>
        </Style>
        <Style Selector="ToggleButton.mode:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Bg3Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style Selector="ToggleButton.mode:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Bg4Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style Selector="ToggleButton.mode:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style Selector="ToggleButton.mode:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}"/>
        </Style>

        <!-- Sidebar navigation rows (used for both the "All songs" button and playlist entries) -->
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Bg3Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Bg4Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style Selector="Button.nav.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.nav.selected PathIcon">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.nav PathIcon">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>

        <Style Selector="Border.nav-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.nav-item:pointerover">
            <Setter Property="Background" Value="{StaticResource Bg3Brush}"/>
        </Style>
        <Style Selector="Border.nav-item.selected">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
        </Style>
        <Style Selector="Border.nav-item PathIcon">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="Border.nav-item.selected PathIcon">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style Selector="Border.nav-item.selected TextBlock.nav-title">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
        <!-- Row actions (delete / remove) only appear when hovering the row -->
        <Style Selector="Button.row-action">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.nav-item:pointerover Button.row-action, ListBoxItem:pointerover Button.row-action">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- Text boxes -->
        <Style Selector="TextBox.input">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style Selector="TextBox.input /template/ TextBlock#PART_Watermark, TextBox.input /template/ TextBlock#PART_FloatingWatermark">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        </Style>
        <Style Selector="TextBox.input:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Bg4Brush}"/>
        </Style>
        <Style Selector="TextBox.input:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBox.input:pointerover, TextBox.input:focus">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style Selector="TextBox.input.compact">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <!-- Bare text box used inside the search pill -->
        <Style Selector="TextBox.bare">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style Selector="TextBox.bare /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        </Style>
        <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement, TextBox.bare:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.bare:pointerover, TextBox.bare:focus">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style Selector="Border.search-pill">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="40"/>
        </Style>
        <Style Selector="Border.search-pill:focus-within">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <!-- Track list -->
        <Style Selector="ListBox.tracks">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.tracks ListBoxItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinHeight" Value="52"/>
        </Style>
        <Style Selector="ListBox.tracks ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBox.tracks ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}"/>
        </Style>
        <Style Selector="ListBox.tracks ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
        </Style>
        <Style Selector="ListBox.tracks ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
        </Style>
        <Style Selector="ListBox.tracks ListBoxItem /template/ Rectangle#SelectionIndicator">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <Style Selector="TextBlock.track-title">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="TextBlock.track-sub">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBlock.track-meta">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="ListBoxItem:selected TextBlock.track-title">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style Selector="ListBoxItem:selected TextBlock.track-sub, ListBoxItem:selected TextBlock.track-meta">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <!-- The "now playing" bars only show on the playing row -->
        <Style Selector="PathIcon.now-playing">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
        </Style>
        <Style Selector="ListBoxItem:selected PathIcon.now-playing">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="TextBlock.track-index">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="ListBoxItem:selected TextBlock.track-index">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <!-- Row check boxes are quiet until the row is hovered or they are checked -->
        <Style Selector="CheckBox.row-select">
            <Setter Property="Opacity" Value="0.35"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem:pointerover CheckBox.row-select, CheckBox.row-select:checked">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- Sliders -->
        <Style Selector="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style Selector="Slider.progress">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Misc surfaces -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource Bg1Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource Bg3Brush}"/>
        </Style>
    </Application.Styles>
</Application>
