<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MusicPlayer.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="650"
        x:Class="MusicPlayer.Views.DownloadWindow"
        x:DataType="vm:DownloadWindowViewModel"
        Title="YouTube Playlist Downloader"
        Width="700" Height="650"
        MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- Window-local aliases so the layout below keeps its class names; visuals come from App.axaml -->
        <Style Selector="Button.primary-btn">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.primary-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.primary-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentPressedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.primary-btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.secondary-btn">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}"/>
            <Setter Property="Padding" Value="18,10"/>
        </Style>
        <Style Selector="Button.secondary-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Bg3Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style Selector="Button.secondary-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Bg4Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style Selector="Button.secondary-btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style Selector="Button.cancel-btn">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="18,10"/>
        </Style>
        <Style Selector="Button.cancel-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Bg3Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style Selector="Button.cancel-btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:DownloadWindowViewModel/>
    </Design.DataContext>

    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="YouTube Downloader"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}"
                   Margin="0,0,0,24"/>

        <!-- Download Mode Selection -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Download Mode"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Spacing="20">
                <RadioButton Content="Playlist"
                             GroupName="DownloadMode"
                             IsChecked="{Binding IsPlaylistMode}"
                             Foreground="{StaticResource TextBrush}"
                             FontSize="13"/>
                <RadioButton Content="Individual Song(s)"
                             GroupName="DownloadMode"
                             IsChecked="{Binding !IsPlaylistMode}"
                             Foreground="{StaticResource TextBrush}"
                             FontSize="13"/>
            </StackPanel>
        </StackPanel>

        <!-- YouTube URL Input -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="{Binding UrlLabelText}"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>
            <TextBox Classes="input"
                     Text="{Binding YoutubeUrl}"
                     Watermark="{Binding UrlWatermarkText}"
                     IsEnabled="{Binding !IsDownloading}"/>
            <TextBlock Text="{Binding UrlHelperText}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="11"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Output Directory -->
        <StackPanel Grid.Row="3" Margin="0,0,0,16">
            <TextBlock Text="Output Directory"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                         Classes="input"
                         Text="{Binding OutputDirectory}"
                         IsReadOnly="True"/>
                <Button Grid.Column="1"
                        Classes="secondary-btn"
                        Content="Browse"
                        Margin="12,0,0,0"
                        Click="BrowseOutput_Click"
                        IsEnabled="{Binding !IsDownloading}"/>
            </Grid>
            <TextBlock Text="{Binding OutputHelperText}"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="11"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Progress Info -->
        <Border Grid.Row="4"
                Background="{StaticResource Bg1Brush}"
                CornerRadius="12"
                Padding="16"
                Margin="0,0,0,16">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusMessage}"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8">
                        <TextBlock Text="{Binding CurrentProgress}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="16"
                                   FontWeight="Bold"/>
                        <TextBlock Text="/"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="16"/>
                        <TextBlock Text="{Binding TotalVideos}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="16"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

                <!-- Current video title -->
                <TextBlock Text="{Binding CurrentVideoTitle}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           IsVisible="{Binding CurrentVideoTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <!-- Progress bar (visual indicator when downloading) -->
                <ProgressBar IsIndeterminate="{Binding IsDownloading}"
                             Foreground="{StaticResource AccentBrush}"
                             Background="{StaticResource Bg3Brush}"
                             Height="6"
                             CornerRadius="3"
                             IsVisible="{Binding IsDownloading}"/>
            </StackPanel>
        </Border>

        <!-- Download Log -->
        <Border Grid.Row="5"
                Background="{StaticResource Bg1Brush}"
                CornerRadius="12"
                Padding="16"
                Margin="0,0,0,16">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <TextBlock Grid.Column="0"
                               Text="Download Log"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                    <Button Grid.Column="1"
                            Classes="secondary-btn"
                            Content="Clear"
                            Padding="12,4"
                            FontSize="11"
                            Command="{Binding ClearLogCommand}"
                            IsEnabled="{Binding !IsDownloading}"/>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding DownloadLog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           FontFamily="Consolas,Courier New,monospace"
                                           TextWrapping="Wrap"
                                           Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <Grid Grid.Row="6" ColumnDefinitions="*,Auto,Auto,Auto">
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="WebM format  ·  10-second delay between songs"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Classes="secondary-btn"
                    Content="Copy Path"
                    Command="{Binding CopyOutputPathCommand}"
                    IsVisible="{Binding CompletedOutputDirectory, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Margin="0,0,12,0"/>

            <Button Grid.Column="2"
                    Classes="cancel-btn"
                    Content="Cancel"
                    Command="{Binding CancelDownloadCommand}"
                    IsEnabled="{Binding IsDownloading}"
                    Margin="0,0,12,0"/>

            <Button Grid.Column="3"
                    Classes="primary-btn"
                    Content="Start Download"
                    Command="{Binding StartDownloadCommand}"
                    IsEnabled="{Binding CanStartDownload}"/>
        </Grid>
    </Grid>
</Window>
