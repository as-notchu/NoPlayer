<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MusicPlayer.ViewModels"
        xmlns:models="using:MusicPlayer.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="MusicPlayer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/icon2.ico"
        Title="NoPlayer"
        Width="1100" Height="720"
        MinWidth="860" MinHeight="560">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="*,Auto">

        <!-- Sidebar + content -->
        <Grid Grid.Row="0" ColumnDefinitions="252,*">

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="{StaticResource Bg1Brush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,Auto,*,Auto">

                    <!-- Brand -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="20,20,20,18">
                        <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource AccentBrush}">
                            <PathIcon Data="{StaticResource IconMusic}" Width="16" Height="16" Foreground="White"/>
                        </Border>
                        <TextBlock Text="NoPlayer" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Library -->
                    <StackPanel Grid.Row="1" Margin="12,0,12,0">
                        <TextBlock Classes="section-label" Text="LIBRARY" Margin="12,0,0,6"/>
                        <Button Classes="nav"
                                Classes.selected="{Binding SelectedPlaylist, Converter={x:Static ObjectConverters.IsNull}}"
                                Command="{Binding ShowAllSongsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Data="{StaticResource IconLibrary}"/>
                                <TextBlock Text="All songs" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Playlists -->
                    <Grid Grid.Row="2" RowDefinitions="Auto,*" Margin="12,16,12,0">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="12,0,0,6">
                            <TextBlock Classes="section-label" Text="PLAYLISTS" VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Classes="icon small"
                                    Click="CreatePlaylist_Click"
                                    ToolTip.Tip="New playlist from the checked songs">
                                <PathIcon Data="{StaticResource IconPlus}"/>
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Playlists}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:Playlist">
                                        <Border Classes="nav-item"
                                                Classes.selected="{Binding IsSelected}"
                                                Margin="0,0,0,2"
                                                PointerPressed="Playlist_Clicked"
                                                ToolTip.Tip="{Binding DirectoryPath}">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <PathIcon Grid.Column="0"
                                                          Data="{StaticResource IconFolder}"
                                                          IsVisible="{Binding IsDirectoryPlaylist}"
                                                          Margin="0,0,10,0"/>
                                                <PathIcon Grid.Column="0"
                                                          Data="{StaticResource IconPlaylist}"
                                                          IsVisible="{Binding !IsDirectoryPlaylist}"
                                                          Margin="0,0,10,0"/>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Classes="nav-title"
                                                               Text="{Binding Name}"
                                                               FontSize="13"
                                                               FontWeight="Medium"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Classes="muted" FontSize="11" Margin="0,1,0,0">
                                                        <Run Text="{Binding Tracks.Count}"/>
                                                        <Run Text="tracks"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- Delete custom playlist (single click) -->
                                                <Button Grid.Column="2"
                                                        Classes="icon small row-action"
                                                        IsVisible="{Binding !IsDirectoryPlaylist}"
                                                        Click="DeletePlaylist_Click"
                                                        Tag="{Binding}"
                                                        ToolTip.Tip="Delete playlist">
                                                    <PathIcon Data="{StaticResource IconClose}"/>
                                                </Button>
                                                <!-- Remove folder (double click, so it is hard to do by accident) -->
                                                <Button Grid.Column="2"
                                                        Classes="icon small row-action"
                                                        IsVisible="{Binding IsDirectoryPlaylist}"
                                                        DoubleTapped="DeleteDirectoryPlaylist_DoubleTapped"
                                                        Tag="{Binding}"
                                                        ToolTip.Tip="Double-click to remove this folder from the library">
                                                    <PathIcon Data="{StaticResource IconClose}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Sources -->
                    <Border Grid.Row="3"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="20,14,20,16">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="section-label" Text="SOURCES" Margin="0,0,0,2"/>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0"
                                         Classes="input compact"
                                         Text="{Binding MusicFolderPath}"
                                         Watermark="Main music folder"
                                         IsReadOnly="True"
                                         ToolTip.Tip="{Binding MusicFolderPath}"/>
                                <Button Grid.Column="1"
                                        Classes="icon"
                                        Margin="6,0,0,0"
                                        Width="32" Height="32"
                                        Click="BrowseFolder_Click"
                                        ToolTip.Tip="Choose main music folder">
                                    <PathIcon Data="{StaticResource IconFolder}" Width="15" Height="15"/>
                                </Button>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0"
                                         x:Name="DirectoriesTextBox"
                                         Classes="input compact"
                                         AcceptsReturn="False"
                                         Watermark="Paste folder paths"
                                         ToolTip.Tip="Paste one or more folder paths, separated by commas"/>
                                <Button Grid.Column="1"
                                        Classes="icon"
                                        Margin="6,0,0,0"
                                        Width="32" Height="32"
                                        Click="AddDirectories_Click"
                                        ToolTip.Tip="Add folders to the library">
                                    <PathIcon Data="{StaticResource IconPlus}" Width="15" Height="15"/>
                                </Button>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                                <Button Grid.Column="0"
                                        Classes="secondary"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,4,0"
                                        Command="{Binding LoadLibraryCommand}"
                                        IsEnabled="{Binding !IsLoading}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource IconRefresh}"/>
                                        <TextBlock Text="Rescan" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1"
                                        Classes="secondary"
                                        HorizontalAlignment="Stretch"
                                        Margin="4,0,0,0"
                                        Click="OpenDownloadWindow_Click"
                                        ToolTip.Tip="Download music from YouTube">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource IconDownload}"/>
                                        <TextBlock Text="YouTube" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="28,24,28,0">

                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedPlaylist.Name, FallbackValue='All songs'}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Classes="secondary"
                                   Text="{Binding StatusMessage}"
                                   FontSize="12"
                                   Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="secondary" Click="CreatePlaylist_Click" ToolTip.Tip="Create a playlist from the checked songs">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <PathIcon Data="{StaticResource IconPlaylistPlus}"/>
                                <TextBlock Text="New playlist" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="secondary" Click="AddToPlaylist_Click" ToolTip.Tip="Add the checked songs to a playlist">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <PathIcon Data="{StaticResource IconPlus}"/>
                                <TextBlock Text="Add to playlist" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Search -->
                <Border Grid.Row="1" Classes="search-pill" Margin="0,18,0,10">
                    <Grid ColumnDefinitions="Auto,*">
                        <PathIcon Grid.Column="0"
                                  Data="{StaticResource IconSearch}"
                                  Width="15" Height="15"
                                  Foreground="{StaticResource TextMutedBrush}"
                                  Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1"
                                 Classes="bare"
                                 Text="{Binding SearchText}"
                                 Watermark="Search songs, artists or albums"/>
                    </Grid>
                </Border>

                <!-- Empty state -->
                <StackPanel Grid.Row="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="10"
                            IsVisible="{Binding EmptyStateText, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Border Width="64" Height="64" CornerRadius="20" Background="{StaticResource Bg2Brush}" HorizontalAlignment="Center">
                        <PathIcon Data="{StaticResource IconMusic}" Width="26" Height="26" Foreground="{StaticResource TextMutedBrush}"/>
                    </Border>
                    <TextBlock Classes="secondary"
                               Text="{Binding EmptyStateText}"
                               FontSize="13"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Track list -->
                <ListBox Grid.Row="2"
                         x:Name="TrackList"
                         Classes="tracks"
                         ItemsSource="{Binding Tracks}"
                         SelectedItem="{Binding CurrentTrack, Mode=OneWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="TrackList_SelectionChanged"
                         Margin="0,0,0,8">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Track">
                            <Grid ColumnDefinitions="Auto,24,*,Auto,Auto">
                                <!-- Multi-select for playlists -->
                                <CheckBox Grid.Column="0"
                                          Classes="row-select"
                                          IsChecked="{Binding IsSelected}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0"/>

                                <!-- Now playing indicator -->
                                <PathIcon Grid.Column="1"
                                          Classes="now-playing"
                                          Data="{StaticResource IconEqualizer}"
                                          VerticalAlignment="Center"/>

                                <!-- Title / artist · album -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Classes="track-title"
                                               Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Classes="track-sub"
                                               Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding DisplayArtist}"/>
                                        <Run Text="  ·  " Foreground="{StaticResource TextMutedBrush}"/>
                                        <Run Text="{Binding DisplayAlbum}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Duration -->
                                <TextBlock Grid.Column="3"
                                           Classes="track-meta"
                                           Text="{Binding DurationFormatted}"
                                           VerticalAlignment="Center"
                                           Margin="16,0,0,0"/>

                                <!-- Remove from custom playlist -->
                                <Button Grid.Column="4"
                                        Classes="icon small row-action"
                                        Margin="8,0,0,0"
                                        Click="RemoveFromPlaylist_Click"
                                        Tag="{Binding}"
                                        ToolTip.Tip="Remove from this playlist"
                                        IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CanRemoveFromPlaylist}">
                                    <PathIcon Data="{StaticResource IconMinus}"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <!-- Player bar -->
        <Border Grid.Row="1"
                Background="{StaticResource Bg1Brush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,10,20,14">
            <Grid RowDefinitions="Auto,Auto">

                <!-- Progress -->
                <Grid Grid.Row="0" ColumnDefinitions="44,*,44" Margin="0,0,0,6">
                    <TextBlock Grid.Column="0"
                               Classes="secondary"
                               Text="{Binding CurrentTimeFormatted}"
                               VerticalAlignment="Center"
                               FontSize="11"/>
                    <Slider Grid.Column="1"
                            x:Name="ProgressSlider"
                            Classes="progress"
                            Minimum="0" Maximum="100"
                            Value="{Binding Position}"
                            Margin="10,0"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2"
                               Classes="secondary"
                               Text="{Binding TotalTimeFormatted}"
                               VerticalAlignment="Center"
                               FontSize="11"
                               TextAlignment="Right"/>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*">

                    <!-- Now playing. A Grid (not a StackPanel) so the text column is capped at the
                         remaining width and long titles get trimmed instead of running under the buttons. -->
                    <Grid Grid.Column="0" ColumnDefinitions="Auto,*" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Border Grid.Column="0" Width="46" Height="46" CornerRadius="10" Background="{StaticResource Bg2Brush}">
                            <PathIcon Data="{StaticResource IconMusic}"
                                      Width="20" Height="20"
                                      Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    MaxWidth="320"
                                    Margin="12,0,0,0">
                            <TextBlock Text="{Binding CurrentTrack.DisplayName, FallbackValue='Nothing playing'}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Classes="secondary"
                                       Text="{Binding CurrentTrack.DisplayArtist, FallbackValue='Pick a song to start'}"
                                       FontSize="12"
                                       Margin="0,1,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Classes="muted"
                                       FontSize="11"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding UpNextTrack, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <Run Text="Up next · "/>
                                <Run Text="{Binding UpNextTrack.DisplayName, FallbackValue=''}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Transport -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <ToggleButton Classes="mode"
                                      IsChecked="{Binding ShuffleEnabled}"
                                      ToolTip.Tip="Shuffle - deals a random queue of the current list">
                            <PathIcon Data="{StaticResource IconShuffle}"/>
                        </ToggleButton>

                        <Button Classes="icon"
                                Command="{Binding PlayPreviousCommand}"
                                Margin="6,0,0,0"
                                ToolTip.Tip="Previous (Ctrl+←)">
                            <PathIcon Data="{StaticResource IconPrevious}"/>
                        </Button>

                        <Button Classes="icon"
                                Command="{Binding SeekBackwardCommand}"
                                ToolTip.Tip="Back 10 seconds (←)">
                            <PathIcon Data="{StaticResource IconRewind}"/>
                        </Button>

                        <Button Classes="play"
                                Command="{Binding TogglePlayPauseCommand}"
                                Margin="6,0"
                                ToolTip.Tip="Play / pause (Space)">
                            <Panel>
                                <PathIcon Data="{StaticResource IconPlay}"
                                          IsVisible="{Binding !IsPlaying}"
                                          Margin="3,0,0,0"/>
                                <PathIcon Data="{StaticResource IconPause}"
                                          IsVisible="{Binding IsPlaying}"/>
                            </Panel>
                        </Button>

                        <Button Classes="icon"
                                Command="{Binding SeekForwardCommand}"
                                ToolTip.Tip="Forward 10 seconds (→)">
                            <PathIcon Data="{StaticResource IconForward}"/>
                        </Button>

                        <Button Classes="icon"
                                Command="{Binding PlayNextCommand}"
                                Margin="0,0,6,0"
                                ToolTip.Tip="Next (Ctrl+→)">
                            <PathIcon Data="{StaticResource IconNext}"/>
                        </Button>

                        <ToggleButton Classes="mode"
                                      IsChecked="{Binding RepeatEnabled}"
                                      ToolTip.Tip="Repeat the list">
                            <PathIcon Data="{StaticResource IconRepeat}"/>
                        </ToggleButton>
                        <ToggleButton Classes="mode"
                                      IsChecked="{Binding RepeatOneEnabled}"
                                      ToolTip.Tip="Repeat this song">
                            <PathIcon Data="{StaticResource IconRepeatOne}"/>
                        </ToggleButton>
                    </StackPanel>

                    <!-- Volume -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Spacing="10">
                        <PathIcon Data="{StaticResource IconVolume}"
                                  Width="16" Height="16"
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Slider Minimum="0" Maximum="100"
                                Value="{Binding Volume}"
                                Width="110"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
